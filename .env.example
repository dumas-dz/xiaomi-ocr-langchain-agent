# ===== Agent 大脑：任意 OpenAI 兼容 API =====
# DeepSeek 示例
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=deepseek-chat

# 智谱 GLM 示例（取消注释替换上面三项）
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_API_KEY=your-glm-key
# OPENAI_MODEL=glm-4.7

# ===== 小米 OCR 本地推理后端（Ollama）=====
XIAOMI_OCR_LOCAL_URL=http://127.0.0.1:11434/v1
XIAOMI_OCR_MODEL=longwayxu/xiaomi-ocr-0:bf16

# ===== 仓库与 MCP 服务端解释器（默认指向本机克隆）=====
XIAOMI_OCR_REPO=/Users/Dumas/WorkSpaces/GitHubProjects/Xiaomi-OCR-0
XIAOMI_OCR_MCP_PYTHON=/Users/Dumas/WorkSpaces/GitHubProjects/Xiaomi-OCR-0/.venv/bin/python

# ===== 可选 =====
# XIAOMI_OCR_MAX_TOKENS=4096
# XIAOMI_OCR_LAYOUT_DEVICE=cpu   # 区域模式版面检测用 CPU 时设置
